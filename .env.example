# 飞书企业自建应用凭证。不要将真实 App Secret 提交到代码仓库。
FEISHU_AUTH_ENABLED=true
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace_with_real_secret

# 必须和飞书开发者后台“安全设置 -> 重定向 URL”完全一致。
FEISHU_REDIRECT_URI=http://localhost:8088/api/v1/auth/callback
FRONTEND_URI=http://localhost:8088/

# 生产 HTTPS 环境应设为 true。
SESSION_COOKIE_SECURE=false
